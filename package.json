    "finalize:appimage": "bash scripts/finalize-appimage.sh \"src-tauri/target/release/bundle/appimage/Apimeter_0.1.4_amd64.AppImage\" \"src-tauri/target/release/bundle/appimage/Apimeter_0.1.4_amd64-xwayland.AppImage\"",
    "build:linux": "npm run tauri:build && npm run finalize:deb && npm run finalize:appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
